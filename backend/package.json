{
  "name": "pipestock-backend",
  "private": true,
  "version": "0.1.0",
  "description": "PipeStock Node HTTP API with Prisma and PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "catalog:sync": "node tools/sync-official-materials.js",
    "test": "node --test tests/*.test.js",
    "postinstall": "node tools/prisma-postinstall.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "pdfmake": "0.2.23"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
