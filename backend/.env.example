# Backend-only environment variables. Do not put VITE_* variables here.
BACKEND_PORT=3001
TZ=Europe/Prague

# Local development frontend origins. Production is same-origin on Render.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL runtime connection used by Prisma Client.
DATABASE_URL=postgresql://user:password@host:5432/pipestock?schema=public

# Optional direct PostgreSQL connection reserved for migration tooling/proxy setups.
DIRECT_DATABASE_URL=

# Reserved for PipeStock authentication. Use at least 32 random characters in production.
AUTH_TOKEN_SECRET=replace-with-32-plus-char-random-secret

# Optional project/site image storage. Keep API secret on the backend only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
