generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  COMPLETED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String    @default("")
  lastName     String    @default("")
  name         String
  phone        String?   @unique
  profile      Json      @default("{}")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          Session[]
  memberships       CompanyMembership[]
  materialFavorites MaterialFavorite[]

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Company {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  joinCode          String?   @unique
  joinCodeCreatedAt DateTime?
  joinCodeExpiresAt DateTime?
  joinCodeRevokedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships CompanyMembership[]
  projects    Project[]
  orders      Order[]

  @@index([joinCode])
  @@map("companies")
}

model CompanyMembership {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   ProjectAssignment[]
  createdOrders Order[]             @relation("OrderCreator")
  orderEvents   OrderEvent[]        @relation("OrderEventActor")

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
  @@index([companyId, deletedAt])
  @@map("company_memberships")
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  address     String?
  description String?
  imageUrl    String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments ProjectAssignment[]
  orders      Order[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("projects")
}

model ProjectAssignment {
  id           String   @id @default(cuid())
  projectId    String
  membershipId String
  assignedAt   DateTime @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([projectId, membershipId])
  @@index([membershipId])
  @@map("project_assignments")
}

model MaterialCatalogItem {
  id            String   @id
  key           String   @unique
  categoryKey   String
  categoryLabel String
  diameter      String
  type          String
  name          String
  unit          String
  imageUrl      String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
  favorites  MaterialFavorite[]

  @@index([categoryKey, diameter, isActive])
  @@index([isActive, sortOrder])
  @@map("material_catalog_items")
}

model MaterialFavorite {
  id            String   @id @default(cuid())
  userId        String
  catalogItemId String
  createdAt     DateTime @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem MaterialCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([userId, catalogItemId])
  @@index([userId, createdAt])
  @@map("material_favorites")
}

model Order {
  id                    String      @id @default(cuid())
  number                Int         @unique @default(autoincrement())
  companyId             String
  projectId             String
  createdByMembershipId String
  title                 String
  category              String?
  note                  String?
  status                OrderStatus @default(DRAFT)
  submittedAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdByMembership CompanyMembership @relation("OrderCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  snapshot            OrderSnapshot?
  events              OrderEvent[]

  @@index([companyId, status])
  @@index([projectId, createdAt])
  @@index([createdByMembershipId, createdAt])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  catalogItemId String?
  materialKey   String
  materialName  String
  categoryKey   String
  categoryLabel String
  diameter      String
  type          String
  unit          String
  imageUrl      String?
  quantity      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem MaterialCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([catalogItemId])
  @@map("order_items")
}

model OrderSnapshot {
  id        String   @id @default(cuid())
  orderId   String   @unique
  version   Int      @default(1)
  payload   Json
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("order_snapshots")
}

model OrderEvent {
  id                String   @id @default(cuid())
  orderId           String
  actorMembershipId String?
  type              String
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor CompanyMembership? @relation("OrderEventActor", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorMembershipId])
  @@map("order_events")
}
