{
  "name": "pipestock",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile-first material tracking for plumbers and installers",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.js",
    "dev:client": "vite",
    "dev:server": "npm --prefix backend run dev",
    "assets:validate": "node tools/validate-material-assets.mjs",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:migrate:deploy": "npm --prefix backend run db:migrate:deploy",
    "build:web": "npm run assets:validate && vite build --config vite.config.js",
    "build": "npm run db:generate && npm run build:web",
    "test": "npm --prefix backend test",
    "verify": "npm run test && npm run build",
    "start": "npm --prefix backend run start"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.11.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-redux": "9.2.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "5.4.6"
  }
}
